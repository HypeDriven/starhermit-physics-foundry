# Generated by tools/gen-plays.mjs: the Speedrun Bay challenge on a phone held sideways (844 x 390, DPR 3):
# the setup panel, the chamber, the pause panel and back, then the planned build run to its results.
# viewport 844x390@3
until 600 Daily challenge
frames 10
touch =All modes
until 120 Choose a mode
frames 10
touch =Challenge
frames 10
save challenge-setup
touch =Speedrun Bay
until 300 Spawns left
frames 30
save challenge-2
touch =Pause (Esc)
until 60 Restart chamber
frames 10
save challenge-pause
touch =Resume
frames 10
touch =Run (R)
frames 30
save challenge-2-run
until 1200 Score breakdown
expect Delivery complete
frames 10
save challenge-results
