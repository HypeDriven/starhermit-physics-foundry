{
  "name": "physics-foundry",
  "version": "1.0.0",
  "description": "Physics Foundry — spawn materials, rig joints and run the chamber to deliver every payload. An industrial physics puzzle on the StarHermit engine.",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.mjs tests/server.test.mjs tests/progress.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "start": "node server.js",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
